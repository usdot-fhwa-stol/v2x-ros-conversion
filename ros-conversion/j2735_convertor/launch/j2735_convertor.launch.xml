<!--
This file can be used to launch the CARMA j2735_convertor_node.
  Though in carma-platform it may be launched directly from the base launch file.
-->
<launch>

    <!-- Declare the log_level launch argument -->
    <arg name="log_level" default="WARN"/>

    <!-- Launch node(s) in a carma container to allow logging to be configured -->
    <node_container
        pkg="carma_ros2_utils"
        exec="carma_component_container_mt"
        name="j2735_convertor_container"
        namespace="/">

        <!-- Launch the core node(s) -->
        <composable_node
            pkg="j2735_convertor"
            plugin="j2735_convertor::Node"
            name="j2735_convertor_node">
            <extra_arg name="use_intra_process_comms" value="True"/>
            <extra_arg name="--log-level" value="$(var log_level)"/>
        </composable_node>

    </node_container>

</launch>