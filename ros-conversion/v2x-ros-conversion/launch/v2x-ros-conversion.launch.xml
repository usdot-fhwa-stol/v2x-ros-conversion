<launch>

    <arg name="configuration_delay" default="4.0" />

    <node_container
        pkg="carma_ros2_utils"
        name="carma_v2x_container"
        namespace="$(env ROS_NAMESPACE '')"
        exec="carma_component_container_mt"
        on_exit="shutdown">

        <composable_node
            pkg="cpp_message"
            plugin="cpp_message::Node"
            name="cpp_message_node">
            <extra_arg name="use_intra_process_comms" value="true" />
            <extra_arg name="--log-level" value="$(env CARMA_ROS_LOGGING_CONFIG WARN)" />
            <remap from="inbound_binary_msg"
                to="$(env CARMA_INTR_NS hardware_interface)/comms/inbound_binary_msg" />
            <remap from="outbound_binary_msg"
                to="$(env CARMA_INTR_NS hardware_interface)/comms/outbound_binary_msg" />
        </composable_node>

        <composable_node
            pkg="j2735_convertor"
            plugin="j2735_convertor::Node"
            name="j2735_convertor_node">
            <extra_arg name="use_intra_process_comms" value="true" />
            <extra_arg name="--log-level" value="$(env CARMA_ROS_LOGGING_CONFIG WARN)" />
            <remap from="outgoing_bsm" to="bsm_outbound" />
        </composable_node>

    </node_container>

    <timer period="$(var configuration_delay)">

        <executable
            cmd="ros2 lifecycle set /cpp_message_node configure"
            name="process_configure_cpp_message"
            output="screen" />

        <executable
            cmd="ros2 lifecycle set /j2735_convertor_node configure"
            name="process_configure_j2735_convertor"
            output="screen" />

    </timer>

    <on_execution_complete
        target="process_configure_cpp_message">
        <executable
            cmd="ros2 lifecycle set /cpp_message_node activate"
            output="screen" />
    </on_execution_complete>


    <on_execution_complete
        target="process_configure_j2735_convertor">
        <executable
            cmd="ros2 lifecycle set /j2735_convertor_node activate"
            output="screen" />
    </on_execution_complete>

</launch>